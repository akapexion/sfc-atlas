# Backend Environment Variables
# Copy this file to .env and fill in your values

PORT=5000

# MongoDB Atlas connection string (replace with your Atlas URI)
DB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Your Vercel frontend URL (set after first deploy, e.g. https://sfc-atlas.vercel.app)
FRONTEND_URL=https://your-vercel-app.vercel.app

# Node environment
NODE_ENV=production
